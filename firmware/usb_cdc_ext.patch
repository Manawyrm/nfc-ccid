+/** Additional USB function exposed next to CDC interface 0 (usb_cdc_ext mode)
+ *
+ * Pass a pointer to this structure as context to furi_hal_usb_set_config(&usb_cdc_ext, ...).
+ * It must stay valid until another USB mode is set.
+ *
+ * The extension may use endpoint numbers 4 to 7 (0x04-0x07 OUT, 0x84-0x87 IN).
+ */
+typedef struct {
+    uint16_t pid; /**< USB product ID, 0 keeps the default CDC product ID */
+    const void* descriptor; /**< Interface, class and endpoint descriptors */
+    uint16_t descriptor_size; /**< Size of descriptor in bytes */
+    uint8_t interface_count; /**< Interfaces in descriptor, numbered from CDC_EXT_FIRST_INTERFACE */
+    usbd_cfg_callback ep_config; /**< Endpoint (de)configuration callback, may be NULL */
+    usbd_ctl_callback control; /**< Control requests not handled by CDC, may be NULL */
+} FuriHalUsbCdcExtension;
+
+/** CDC + extension USB mode, context: FuriHalUsbCdcExtension* */
+extern FuriHalUsbInterface usb_cdc_ext;
